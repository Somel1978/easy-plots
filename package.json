{
  "name": "easy-plots",
  "version": "1.13.0-dev",
  "private": true,
  "type": "module",
  "description": "Foundry VTT narrative engine implementation workspace; complete-module project, incremental integration",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:contract": "node --test tests/contracts.test.mjs tests/security.test.mjs",
    "check": "node tools/check-source.mjs && npm run test:evidence",
    "spec:check": "python spec/tools/validate_spec_v02.py && python tools/report-coverage.py --check",
    "coverage:report": "python tools/report-coverage.py",
    "coverage:check": "python tools/report-coverage.py --check",
    "audit:foundry": "node tools/verify-foundry-sources.mjs",
    "test:evidence": "node tools/run-test-evidence.mjs",
    "review:report": "python tools/review-decisions.py",
    "review:check": "python tools/review-decisions.py --check",
    "qualify:report": "python tools/qualify.py",
    "qualify:check": "python tools/qualify.py --check",
    "qualify:functional": "python tools/qualify.py --gate functional",
    "qualify:release": "python tools/qualify.py --gate release"
  }
}
